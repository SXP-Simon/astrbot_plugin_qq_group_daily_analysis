{
  "name": "daily-analysis-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:no-typecheck": "vite build",
    "generate:types": "openapi-typescript ../openapi.json -o src/shared/api/generated/schema.d.ts",
    "test": "pnpm test:tooling && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:tooling": "node --test scripts/tooling.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
