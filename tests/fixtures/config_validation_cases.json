    "name": "整数不能是数字字符串",
    "config": {
      "basic": {
        "analysis_days": "2"
      }
    },
    "valid": false
  },
  {
    "name": "并发数不能为零",
    "config": {
      "performance": {
        "max_concurrent_llm": 0
      }
    },
    "valid": false
  },
  {
    "name": "透明度不能超过一",
    "config": {
      "basic": {
        "profile_image_opacity": 1.1
      }
    },
    "valid": false
  },
  {
    "name": "布尔字段不接受文字",
    "config": {
      "basic": {
        "filter_bot_messages": "false"
      }
    },
    "valid": false
  },
  {
    "name": "普通文字不接受对象",
    "config": {
      "llm": {
        "llm_provider_id": {}
      }
    },
    "valid": false
  },
  {
    "name": "枚举不接受未知选项",
    "config": {
      "basic": {
        "group_list_mode": "oops"
      }
    },
    "valid": false
  },
  {
    "name": "多选列表不接受未知格式",
    "config": {
      "basic": {
        "output_format": [
          "image",
          "oops"
        ]
      }
    },
    "valid": false
  },
  {
    "name": "深层提示词必须是文字",
    "config": {
      "prompts": {
        "topic_analysis_prompts": {
          "topic_prompt": false
        }
      }
    },
    "valid": false
  },
  {
    "name": "方案列表不接受数组条目",
    "config": {
      "daily_comic": {
        "comic_characters": [
          []
        ]
      }
    },
    "valid": false
  },
  {
    "name": "方案不能使用未知类型",
    "config": {
      "daily_comic": {
        "comic_characters": [
          {
            "__template_key": "oops"
          }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "文件列表不接受数字",
    "config": {
      "daily_comic": {
        "comic_characters": [
          {
            "__template_key": "character",
            "reference_images": [
              1
            ]
          }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "绘图方案递归校验整数",
    "config": {
      "daily_comic": {
        "drawing_provider_overrides": [
          {
            "__template_key": "openai",
            "priority": 0.5
          }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "人格映射必须是JSON对象",
    "config": {
      "basic": {
        "profile_mapping_config": "[]"
      }
    },
    "valid": false
  },
  {
    "name": "人格映射不接受破损JSON",
    "config": {
      "basic": {
        "profile_mapping_config": "{\"mbti\":"
      }
    },
    "valid": false
  },
  {
    "name": "边界值和自定义模板可用",
    "config": {
      "basic": {
        "analysis_days": 1,
        "profile_image_opacity": 0,
        "report_template": "my-theme"
      },
      "llm": {
        "llm_hard_timeout": 0
      }
    },
    "valid": true
  },
  {
    "name": "允许保留旧模型ID和扩展键",
    "config": {
      "llm": {
        "llm_provider_id": "old-id",
        "extension": {
          "keep": true
        }
      },
      "custom_group": {
        "nested": [
          1,
          2
        ]
      }
    },
    "valid": true
  },
  {
    "name": "提示词原文不按JSON猜测",
    "config": {
      "prompts": {
        "topic_analysis_prompts": {
          "topic_prompt": "保留原文 [user] 与 {chat_text}，最多 ${max_topics} 个话题\n${messages_text}"
        }
      }
    },
    "valid": true
  },
  {
    "name": "漫画方案留空后使用相同内置名称时不允许保存",
    "config": {
      "daily_comic": {
        "comic_styles": [
          { "preset_id": "scrapbook_diary", "name": "" },
          { "preset_id": "scrapbook_diary", "name": "  " }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "漫画自定义方案名称不能与另一方案的内置名称重复",
    "config": {
      "daily_comic": {
        "comic_styles": [
          { "preset_id": "classic" },
          {
            "preset_id": "custom",
            "name": " 原版漫画 ",
            "prompt_override": "手绘漫画：${chat_content}，共 ${topic_count} 格。",
            "enable": false
          }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "漫画方案可以复用同一内置风格并分别命名",
    "config": {
      "daily_comic": {
        "comic_styles": [
          { "preset_id": "scrapbook_diary", "name": "生活手账" },
          { "preset_id": "scrapbook_diary", "name": "旅行手账" }
        ]
      }
    },
    "valid": true
  },
  {
    "name": "内置风格的自定义正文也必须写出话题数量",
    "config": {
      "daily_comic": {
        "comic_styles": [
          { "preset_id": "classic", "prompt_override": "请画漫画：${chat_content}，示例 $${topic_count}" }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "旧角色专属正文也必须写出核心话题",
    "config": {
      "daily_comic": {
        "comic_characters": [
          { "name": "角色", "storyboard_prompt": "画 {max_count} 格，示例 {{chat_content}}" }
        ]
      }
    },
    "valid": false
  },
  {
    "name": "漫画风格仍接受旧正文的数量别名及普通 JSON 花括号",
    "config": {
      "daily_comic": {
        "comic_styles": [
          { "preset_id": "custom", "name": "旧风格", "prompt_override": "{chat_content} 共 {max_count} 格，输出 {\"scene\":\"正文\"}" }
        ],
        "comic_characters": [{ "name": "角色", "storyboard_prompt": "" }]
      }
    },
    "valid": true
  },
  {
    "name": "字符参考图和单模板旧数据",
    "config": {
      "daily_comic": {
        "comic_characters": [
          {
            "name": "角色",
            "reference_images": [
              "files/test.png"
            ],
            "extra": {
              "x": 1
            }
          }
        ]
      }
    },
    "valid": true
  },
  {
    "name": "映射允许空值和对象正文",
    "config": {
      "basic": {
        "profile_mapping_config": "{\"mbti\":{}}"
      }
    },
    "valid": true
  },
  {
    "name": "JSON不接受非有限数值",
    "config": {
      "basic": {
        "profile_mapping_config": "{\"value\":NaN}"
      }
    },
    "valid": false
  }
