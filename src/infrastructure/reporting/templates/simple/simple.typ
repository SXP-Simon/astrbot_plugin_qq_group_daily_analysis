// 极简模板沿用原版的文档流、普通边框与横向蓝色小时条，不使用主题卡片布局。
#import "common.typ": runs
#let copy(t,body,size:16,weight:400,fill:black,lh:1.5) = {
  set par(leading:(lh - 1)*size*t.u,spacing:0pt)
  text(size:size*t.u,weight:weight,fill:fill,top-edge:(0.936+(lh - 1)/2)*1em,bottom-edge:-(0.064+(lh - 1)/2)*1em)[#body]
}
#let h2(t,title) = {v(19.92*t.u);copy(t,title,size:24,weight:700,fill:rgb("333333"),lh:35/24);v(19.92*t.u)}
#let section(t,title,body) = {
  block(width:100%,inset:11*t.u,stroke:1*t.u+rgb("cccccc"))[
    #h2(t,title)#body
  ]
  v(20*t.u)
}
#let quality(t,d) = {
  if d.review==none {return}
  let r=d.review
  let colors=("4dabf7","ff922b","51cf66","f06595","845ef7","339af0")
  section(t,"群聊质量分析",[
    #block(width:100%,inset:21*t.u,stroke:1*t.u+rgb("e0e0e0"),radius:8*t.u,fill:white)[
      #align(center)[#copy(t,r.title,size:20,weight:600,fill:rgb("1a1a1a"))#v(4*t.u)#copy(t,r.subtitle,size:13.6,fill:rgb("666666"))]
      #v(20*t.u)
      #block(width:100%,height:12*t.u,fill:rgb("f5f5f5"),radius:6*t.u,clip:true)[
        #grid(columns:r.dimensions.map(x=>calc.max(0.1,x.percentage)*1fr),..r.dimensions.enumerate().map(((i,x))=>rect(width:100%,height:12*t.u,fill:rgb(colors.at(calc.rem(i,6))),stroke:none)))
      ]
      #v(20*t.u)
      #grid(columns:(1fr,1fr),gutter:15*t.u,..r.dimensions.map(x=>block(width:100%,inset:10*t.u,fill:rgb("f9f9f9"),stroke:1*t.u+rgb("f0f0f0"),radius:6*t.u)[
        #copy(t,x.name,size:13.6,weight:600,fill:rgb("333333"))#v(4*t.u)
        #copy(t,[#x.percentage%],size:13.12,weight:600,fill:rgb("666666"))#v(4*t.u)
        #copy(t,runs(t,x.comment),size:13.6,fill:rgb("666666"))
      ]))
      #v(20*t.u)#line(length:100%,stroke:1*t.u+rgb("f0f0f0"))#v(15*t.u)
      #copy(t,[#text(weight:600,fill:rgb("1a1a1a"))[Summary]#h(8*t.u)#runs(t,r.summary)],size:15.2,lh:1.5,fill:rgb("444444"))
    ]
    #v(25*t.u)
  ])
}
#let topics(t,d) = {
  if d.topics.len()==0 {return}
  section(t,"热门话题",[
    #for (i,topic) in d.topics.enumerate() {
      block(width:100%,inset:(bottom:5*t.u),stroke:(bottom:(paint:rgb("cccccc"),thickness:1*t.u,dash:"dashed")))[
        #copy(t,[#text(weight:700)[\##(i+1) #topic.title]#h(4*t.u)#text(size:12.8*t.u,fill:rgb("666666"))[(参与者: #runs(t,topic.contributors))]])
        #v(5*t.u)#copy(t,runs(t,topic.detail))#v(5*t.u)
      ]
      v(10*t.u)
    }
  ])
}
#let portraits(t,d) = {
  if d.portraits.len()==0 {return}
  section(t,"群友称号",[
    #for p in d.portraits {
      block(width:100%,inset:6*t.u,stroke:1*t.u+rgb("eeeeee"),clip:true)[
        #if p.image!="" {place(bottom+right,image(p.image,width:150*t.u,height:90*t.u,fit:"contain"))}
        #copy(t,[#p.name - #p.title],weight:700)
        #box(fill:rgb("eeeeee"),inset:(x:5*t.u,y:2*t.u),radius:3*t.u)[#copy(t,p.profile,size:12.8)]
        #v(5*t.u)#copy(t,runs(t,p.reason),size:14.4,fill:rgb("555555"))
      ]
      v(10*t.u)
    }
  ])
}
#let quotes(t,d) = {
  if d.quotes.len()==0 {return}
  section(t,"群圣经",[
    #for q in d.quotes {
      block(width:100%,inset:(x:10*t.u,y:10*t.u),fill:rgb("f9f9f9"),stroke:(left:3*t.u+rgb("cccccc")))[
        #copy(t,[#text(style:"italic")["#runs(t,q.content)"]])
        #v(5*t.u)
        #align(right)[#copy(t,[— #q.sender],size:12.8)#copy(t,[入选理由: #runs(t,q.reason)],size:11.2,fill:rgb("888888"))]
      ]
      v(10*t.u)
    }
  ])
}
#let render(d,t) = {
  set page(width:940*t.u,height:auto,margin:0pt,fill:white)
  set text(font:if d.font_language=="zh-Hant" {("Noto Sans TC","Noto Sans SC")}else{("Noto Sans SC",)},size:16*t.u,cjk-latin-spacing:none)
  set par(spacing:0pt,leading:0pt)
  let body=block(width:940*t.u,inset:28*t.u)[
    #v(21.44*t.u)#copy(t,[群聊日报 - #d.date],size:32,weight:700,fill:rgb("333333"),lh:46/32)#v(21.44*t.u)
    #section(t,"基础统计",[
      #for line in ([消息数: #d.message_count],[参与人数: #d.participant_count],[总字符数: #d.characters],[表情数: #d.emoji_count],[最活跃时段: #d.peak]) {copy(t,line);v(16*t.u)}
    ])
    #section(t,"活跃度图表",[
      #v(24*t.u)
      #let highest=calc.max(1,..d.hours)
      #for (hour,n) in d.hours.enumerate() {
        grid(columns:(50*t.u,1fr,30*t.u),align:horizon,
          copy(t,(if hour < 10 {"0"}else{""})+str(hour)+":00"),
          block(width:100%,height:10*t.u,fill:rgb("eeeeee"))[#rect(width:(n/highest)*100%,height:10*t.u,fill:rgb("0000ff"),stroke:none)],
          align(right,copy(t,str(n))))
        if hour < 23 {v(5*t.u)}
      }
    ])
    #quality(t,d)#v(25*t.u)#topics(t,d)#v(25*t.u)#portraits(t,d)#v(25*t.u)#quotes(t,d)
    #v(10*t.u)
    #block(width:100%,inset:15*t.u,stroke:(top:1*t.u+rgb("cccccc")))[#align(center)[
      #copy(t,[Generated by AstrBot | #d.generated_at],size:13.6,fill:rgb("666666"),lh:1.8)
      #copy(t,"SXP-Simon/astrbot_plugin_qq_group_daily_analysis",size:13.6,fill:rgb("666666"),lh:1.8)
      #copy(t,[Token Usage: #d.tokens.at(0) (Prompt: #d.tokens.at(1), Completion: #d.tokens.at(2))],size:13.6,fill:rgb("999999"),lh:1.8)
    ]]
  ]
  context {let measured=measure(body);[#metadata((height:measured.height/1pt))<report-size>];body}
}
