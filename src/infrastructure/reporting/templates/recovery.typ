// 恢复版独立于主题、公共组件和图片，保留已准备的全部报告文字。
#let d = json("data.json")
#let u = 72/d.ppi*1pt
#let words(parts) = parts.map(part => part.text).join("")
#set page(width:d.width*u,height:auto,margin:0pt,fill:white)
#set text(font:if d.font_language=="zh-Hant" {("Noto Sans TC","Noto Sans SC","Noto Sans JP")}else{("Noto Sans SC","Noto Sans TC","Noto Sans JP")},size:16*u,fill:rgb("222222"))
#set par(leading:5*u,spacing:10*u)
#let body = block(width:d.width*u,inset:24*u)[
  #text(size:26*u,weight:"bold")[群聊日报 · #d.date]
  #parbreak()
  消息数：#d.message_count · 参与人数：#d.participant_count
  #parbreak()
  总字符数：#d.characters · 表情数：#d.emoji_count
  #parbreak()
  最活跃时段：#d.peak
  #parbreak()
  #text(size:20*u,weight:"bold")[24 小时活跃度]
  #parbreak()
  #grid(columns:(1fr,1fr,1fr,1fr),gutter:8*u,..d.hours.enumerate().map(((hour,count)) => [#hour 时：#count]))
  #parbreak()
  #if d.topics.len()>0 {
    text(size:20*u,weight:"bold")[话题总结]
    parbreak()
    for (i,topic) in d.topics.enumerate() {
      text(weight:"bold")[#(i+1). #topic.title]
      parbreak()
      words(topic.detail)
      parbreak()
      [参与者：#words(topic.contributors)]
      parbreak()
    }
  }
  #if d.portraits.len()>0 {
    text(size:20*u,weight:"bold")[群友画像]
    parbreak()
    for p in d.portraits {
      text(weight:"bold")[#p.name · #p.title · #p.profile]
      parbreak()
      words(p.reason)
      parbreak()
    }
  }
  #if d.quotes.len()>0 {
    text(size:20*u,weight:"bold")[群友金句]
    parbreak()
    for q in d.quotes {
      words(q.content)
      parbreak()
      [—— #q.sender]
      parbreak()
      [入选理由：#words(q.reason)]
      parbreak()
    }
  }
  #if d.review!=none {
    let r=d.review
    text(size:20*u,weight:"bold",r.title)
    parbreak()
    r.subtitle
    parbreak()
    for item in r.dimensions {
      text(weight:"bold")[#item.name · #item.percentage%]
      parbreak()
      words(item.comment)
      parbreak()
    }
    words(r.summary)
    parbreak()
  }
  #text(size:12*u,fill:rgb("666666"))[
    Token：#d.tokens.at(0)（输入：#d.tokens.at(1)，输出：#d.tokens.at(2)）
    #parbreak()
    Generated by AstrBot · #d.generated_at
  ]
]
#body
#context [#metadata((height:here().position().y/1pt))<report-size>]
